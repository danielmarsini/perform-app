VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
VITE_VAPID_PUBLIC_KEY=chiave-pubblica-VAPID-per-le-notifiche-push
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
# Digital Twin (HRV/RHR reali, vedi src/lib/whoop.js): client_id Whoop, va
# bene pubblico (standard OAuth2, mai il client_secret). Serve anche
# registrare come Redirect URL, nel Whoop Developer Dashboard, l'URL
# dell'app (es. https://tuodominio.it/). Il client_secret NON va qui: va
# configurato come secret delle Edge Function whoop-oauth-callback/
# whoop-sync su Supabase (WHOOP_CLIENT_ID + WHOOP_CLIENT_SECRET), mai in
# un file letto dal browser.
VITE_WHOOP_CLIENT_ID=xxxxxxxxxxxx
